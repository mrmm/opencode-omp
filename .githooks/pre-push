#!/usr/bin/env bash
#
# Blocks a push when version/tagging hygiene fails.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# Bypass (use sparingly):
#   git push --no-verify

set -euo pipefail

RED='\033[31m'; GRN='\033[32m'; YEL='\033[33m'; DIM='\033[2m'; RST='\033[0m'

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! command -v bun >/dev/null 2>&1; then
  echo -e "${YEL}!${RST} bun not found — skipping hygiene gate"
  exit 0
fi

# Detect whether this push includes any tags.
PUSHING_TAGS=0
TAGS_PUSHED=()
while read -r local_ref _local_sha remote_ref _remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  case "$local_ref" in
    refs/tags/*)
      PUSHING_TAGS=1
      TAGS_PUSHED+=("${local_ref#refs/tags/}")
      ;;
  esac
done

echo -e "${DIM}pre-push: version + tagging hygiene${RST}"

# Tag format: this repo versions packages independently.
if [ "$PUSHING_TAGS" -eq 1 ]; then
  for tag in "${TAGS_PUSHED[@]}"; do
    if [[ "$tag" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+ ]]; then
      echo -e "${RED}✗${RST} Bare version tag '${tag}'."
      echo -e "  Packages version independently — use ${DIM}<package>@<version>${RST}."
      exit 1
    fi
    # Valid tag bases are the published package names with any scope stripped,
    # read from packages/ so this cannot drift as packages are added.
    TAG_BASE="${tag%@*}"
    KNOWN=0
    for d in packages/*/package.json; do
      [ -f "$d" ] || continue
      NAME="$(node -e "process.stdout.write(require('./$d').name||'')" 2>/dev/null)"
      BASE="${NAME##*/}"
      [ "$TAG_BASE" = "$BASE" ] && KNOWN=1
    done
    if [ "$KNOWN" -ne 1 ]; then
      echo -e "${RED}✗${RST} Tag '${tag}' has no matching package."
      exit 1
    fi
    if [[ ! "$tag" =~ @[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]]; then
      echo -e "${RED}✗${RST} Tag '${tag}' does not end in a semver version."
      exit 1
    fi
    echo -e "${GRN}✓${RST} tag format ok: ${tag}"
  done
fi

# A broken build must not be pushable. This gap let a typecheck failure reach
# main: the hook validated versions but never compiled anything.
# CI installs with --frozen-lockfile, so a lockfile that does not match
# package.json fails every job before a single test runs. Adding a workspace
# package drifted it once and reached main, because this gate ran tests and
# typecheck but never the install CI actually performs.
echo -e "${DIM}pre-push: lockfile${RST}"
if ! bun install --frozen-lockfile >/tmp/omp-lock.log 2>&1; then
  echo -e "${RED}✗${RST} bun.lock does not match package.json — CI would fail:"
  grep -E "error|note" /tmp/omp-lock.log | head -4 | sed 's/^/    /'
  echo -e "    run ${DIM}bun install${RST} and commit bun.lock"
  exit 1
fi
echo -e "${GRN}✓${RST} lockfile matches"

echo -e "${DIM}pre-push: typecheck${RST}"
if ! bun run typecheck >/tmp/omp-typecheck.log 2>&1; then
  echo -e "${RED}✗${RST} typecheck failed:"
  grep -E "error TS" /tmp/omp-typecheck.log | head -10 | sed 's/^/    /'
  exit 1
fi
echo -e "${GRN}✓${RST} typecheck clean"

echo -e "${DIM}pre-push: tests${RST}"
if ! bun test >/tmp/omp-test.log 2>&1; then
  echo -e "${RED}✗${RST} tests failed:"
  grep -E "\(fail\)|error:" /tmp/omp-test.log | head -10 | sed 's/^/    /'
  exit 1
fi
echo -e "${GRN}✓${RST} $(grep -oE '[0-9]+ pass' /tmp/omp-test.log | head -1)"

# Strict tag checks only when tags are actually being pushed.
if [ "$PUSHING_TAGS" -eq 1 ]; then
  bun scripts/check-versions.ts --tags
else
  bun scripts/check-versions.ts
fi

echo -e "${GRN}✓${RST} hygiene gate passed"
