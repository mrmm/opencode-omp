{
  "name": "@mrmm/telemetry",
  "version": "0.2.0",
  "type": "module",
  "description": "Local-first telemetry with an optional OpenTelemetry bridge. JSONL by default, zero dependencies, no network.",
  "keywords": [
    "telemetry",
    "opentelemetry",
    "otel",
    "metrics",
    "jsonl",
    "local-first",
    "observability"
  ],
  "homepage": "https://github.com/mrmm/opencode-omp/tree/main/packages/telemetry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrmm/opencode-omp.git",
    "directory": "packages/telemetry"
  },
  "bugs": {
    "url": "https://github.com/mrmm/opencode-omp/issues"
  },
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "test": "bun test"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0",
    "js-tiktoken": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "js-tiktoken": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "js-tiktoken": "^1.0.21"
  },
  "bin": {
    "omp-telemetry": "./src/cli.ts"
  }
}
