{
  "name": "opencode-omp",
  "private": true,
  "type": "module",
  "description": "OpenCode plugins backed by oh-my-pi: hashline patch editing + snapcompact bitmap context compression",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrmm/opencode-omp.git"
  },
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "bun run typecheck && bun test && bun run check:versions",
    "check:versions": "bun scripts/check-versions.ts",
    "check:versions:tags": "bun scripts/check-versions.ts --tags",
    "prepare": "git config core.hooksPath .githooks || true",
    "release:derive": "bun scripts/derive-version.ts",
    "release:preview": "bun scripts/auto-release.ts --dry-run",
    "release:auto": "bun scripts/auto-release.ts",
    "telemetry": "bun packages/telemetry/src/cli.ts",
    "telemetry:verdict": "bun packages/telemetry/src/cli.ts verdict"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0",
    "js-tiktoken": "^1.0.21"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
