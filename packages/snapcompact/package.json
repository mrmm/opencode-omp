{
  "name": "opencode-omp-snapcompact",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenCode plugin: density-gated bitmap context compression, backed by @oh-my-pi/snapcompact. Renders dense text to PNG frames vision models read back.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "context-compression",
    "compaction",
    "vision",
    "tokens",
    "llm"
  ],
  "homepage": "https://github.com/mrmm/opencode-omp/tree/main/packages/snapcompact",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrmm/opencode-omp.git",
    "directory": "packages/snapcompact"
  },
  "bugs": {
    "url": "https://github.com/mrmm/opencode-omp/issues"
  },
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@oh-my-pi/snapcompact": "^17.1.3",
    "js-tiktoken": "^1.0.21"
  },
