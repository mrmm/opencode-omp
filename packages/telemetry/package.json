{
  "name": "@mrmm/opencode-omp-telemetry",
  "version": "0.0.0",
  "type": "module",
  "description": "Shared OpenTelemetry-shaped telemetry for opencode-omp plugins. Local JSONL by default, OTLP via an optional peer dependency.",
  "keywords": [
    "opencode",
    "telemetry",
    "opentelemetry",
    "otel",
    "metrics",
    "jsonl"
  ],
  "homepage": "https://github.com/mrmm/opencode-omp/tree/main/packages/telemetry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrmm/opencode-omp.git",
    "directory": "packages/telemetry"
  },
  "bugs": {
    "url": "https://github.com/mrmm/opencode-omp/issues"
  },
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "test": "bun test"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1"
  }
}
